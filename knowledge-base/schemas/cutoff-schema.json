{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CutoffDataset",
  "description": "Structured schema for GGSIPU cutoff rank datasets across rounds and quotas",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "datasetTitle": {
          "type": "string"
        },
        "academicYear": {
          "type": "string"
        },
        "exam": {
          "type": "string"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collegeCode": {
            "type": "string"
          },
          "collegeName": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "enum": [
              "Delhi",
              "Outside Delhi",
              "All India"
            ]
          },
          "round": {
            "type": "number"
          },
          "minRank": {
            "type": "number"
          },
          "maxRank": {
            "type": "number"
          },
          "priority": {
            "type": "string"
          },
          "shift": {
            "type": "string"
          }
        },
        "required": [
          "collegeCode",
          "branch",
          "category",
          "region",
          "minRank",
          "maxRank"
        ]
      }
    }
  }
}